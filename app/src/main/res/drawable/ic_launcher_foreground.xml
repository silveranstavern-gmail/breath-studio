<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Thin Translucent Inner Ring -->
    <path
        android:pathData="M 54,28 A 26,26 0 1,1 53.9,28 Z"
        android:strokeColor="#00FFE0"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.25"
        android:fillColor="#00000000" />

    <!-- 2. Main Gradient Ring -->
    <path
        android:pathData="M 54,22 A 32,32 0 1,1 53.9,22 Z"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="22"
                android:endX="86"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#00FFE0" />
                <item android:offset="0.4" android:color="#00C8FF" />
                <item android:offset="1.0" android:color="#0052FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Central Smooth Waveform (Bezier curve) -->
    <path
        android:pathData="M 28,54 C 35,54 37,56.5 42,56.5 C 47,56.5 49,38 54,38 C 59,38 61,56.5 66,56.5 C 71,56.5 73,54 80,54"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- 4. Top-Right Orbital Arc & Dots -->
    <!-- Arc from 290° to 340° (Radius 38) -->
    <path
        android:pathData="M 67.0,18.3 A 38,38 0 0,1 89.7,41.0"
        android:strokeColor="#00C8FF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- Small Dot (12:30 o'clock) -->
    <path
        android:pathData="M 57.3,16.1 A 1.5,1.5 0 1,1 57.2,16.1 Z"
        android:fillColor="#00FFE0" />
    <!-- Large Dot (2 o'clock) -->
    <path
        android:pathData="M 91.8,50.7 A 2.5,2.5 0 1,1 91.7,50.7 Z"
        android:fillColor="#00C8FF" />

    <!-- 5. Bottom-Left Orbital Arc & Dots -->
    <!-- Arc from 110° to 160° (Radius 38) -->
    <path
        android:pathData="M 41.0,89.7 A 38,38 0 0,1 18.3,67.0"
        android:strokeColor="#0052FF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- Small Dot (6:30 o'clock) -->
    <path
        android:pathData="M 50.7,91.8 A 1.5,1.5 0 1,1 50.6,91.8 Z"
        android:fillColor="#0052FF" />
    <!-- Large Dot (8 o'clock) -->
    <path
        android:pathData="M 16.2,57.3 A 2.5,2.5 0 1,1 16.1,57.3 Z"
        android:fillColor="#00A2FF" />

</vector>
