# Set default behavior to handle line endings.
* text=auto

# Explicitly set line endings to LF for all text files.
# This prevents switching between CRLF and LF when working across Windows and WSL.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
.gitignore text eol=lf
